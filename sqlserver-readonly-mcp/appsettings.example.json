{
  "$schema": "./appsettings.schema.json",
  "connection": {
    "authentication": "sqlPassword",
    "server": "",
    "username": "",
    "password": "",
    "encrypt": true,
    "trustServerCertificate": true,
    "connectTimeoutSeconds": 10,
    "maxPoolSize": 2
  },
  "capabilities": {
    "listFunction": "",
    "checkFunction": "",
    "pageSize": 100
  },
  "query": {
    "timeoutSeconds": 60,
    "maxRows": 500,
    "maxResultSizeKb": 512,
    "maxConcurrentQueries": 2
  },
  "logging": {
    "directory": "logs",
    "retentionDays": 20,
    "minimumLevel": "Information",
    "includeSqlText": false,
    "maxSqlTextChars": 65536
  }
}
