{
  "$schema": "./appsettings.schema.json",
  "connection": {
    "server": "",
    "username": "",
    "password": "",
    "defaultDatabase": "",
    "encrypt": true,
    "trustServerCertificate": true,
    "connectTimeoutSeconds": 10,
    "maxPoolSize": 2
  },
  "query": {
    "timeoutSeconds": 60,
    "maxRows": 200,
    "maxResultSizeKb": 256,
    "maxConcurrentQueries": 2
  },
  "logging": {
    "directory": "logs",
    "retentionDays": 20,
    "minimumLevel": "Information",
    "includeSqlText": false,
    "maxSqlTextChars": 65536
  }
}
